{
  "name": "@assetmov/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests prisma.config.ts eslint.config.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "test": "tsx --test tests/asset-lifecycle.test.ts tests/assignment-policy.test.ts tests/location-scope.test.ts tests/password.test.ts tests/transfer-status.test.ts tests/subscription-policy.test.ts",
    "db:seed:plans": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy",
    "test:integration": "node --import tsx --test tests/integration/api-acceptance.test.ts",
    "db:status": "prisma migrate status",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.0",
    "zod": "^4.1.0",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "prisma": "^7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "@eslint/js": "^9.34.0",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.40.0",
    "@types/cookie-parser": "^1.4.9"
  }
}
