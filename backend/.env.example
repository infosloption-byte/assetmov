NODE_ENV=development
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:5176
DATABASE_URL=mysql://root:@127.0.0.1:3306/assetmov
DB_CONNECTION_LIMIT=5
LOG_LEVEL=info

# Paddle — sandbox only while integration and webhooks are tested
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Paddle public client token may be present on both sides; never expose the API key or webhook secret.
PADDLE_CLIENT_TOKEN=
# Public HTTPS frontend origin approved for Paddle transactions, without a path.
APP_PUBLIC_URL=https://assetmov-sandbox.example.com

# Optional P0 transactional identity mail. Configure a verified Resend sender.
# Never commit real API keys; keep REQUIRE_VERIFIED_EMAIL=false until delivery is tested.
EMAIL_DELIVERY_API_KEY=
EMAIL_FROM_ADDRESS=
REQUIRE_VERIFIED_EMAIL=false
