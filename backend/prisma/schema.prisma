generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum AssetStatus {
  DRAFT
  AVAILABLE
  ASSIGNED
  IN_TRANSIT
  IN_SERVICE
  DAMAGED
  DISPOSED
  RETIRED
}

enum AssetEventType {
  REGISTERED
  ASSIGNED
  UNASSIGNED
  TRANSFER_DISPATCHED
  TRANSFER_RECEIVED
  TRANSFER_REJECTED
  CHECKED_IN
  CHECKED_OUT
  MARKED_DAMAGED
  MARKED_AVAILABLE
  DISPOSED
  RETIRED
  SERVICE_STARTED
  SERVICE_COMPLETED
  UPGRADED
  CORRECTED
}

enum TransferStatus {
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  REJECTED
  CANCELLED
}

enum TransferLineStatus {
  IN_TRANSIT
  RECEIVED
  REJECTED
}

enum AssetRequestType {
  ASSET
  SOFTWARE
  SERVICE
}

enum RequestStatus {
  PENDING
  CHANGES_REQUESTED
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  CANCELLED
  FULFILLMENT_IN_PROGRESS
  FULFILLED
}

enum ServiceStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_VENDOR
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  CANCEL_AT_PERIOD_END
  EXPIRED
  SUSPENDED
}

model Tenant {
  id                String @id @default(cuid()) @db.VarChar(36)
  name              String               @db.VarChar(191)
  slug              String               @unique @db.VarChar(100)
  status            TenantStatus         @default(TRIAL)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  memberships       Membership[]
  roles             Role[]
  requestItems      AssetRequestItem[]
  membershipLocations MembershipLocation[]
  locations         Location[]
  employees         Employee[]
  categories        AssetCategory[]
  assetModels       AssetModel[]
  suppliers         Supplier[]
  manufacturers     Manufacturer[]
  assets            Asset[]
  assetTransactions AssetTransaction[]
  transfers         AssetTransfer[]
  transferLines     AssetTransferLine[]
  auditLogs         AuditLog[]
  requests          AssetRequest[]
  serviceRecords    ServiceRecord[]
  softwareLicenses  SoftwareLicense[]
  assetTags         AssetTag[]
  licenseAssignments LicenseAssignment[]
  subscription      TenantSubscription?
  files             TenantStorageObject[]
  paddleBillingCustomer PaddleBillingCustomer?
  paddleCheckoutAttempts PaddleCheckoutAttempt[]
  paddlePayments PaddlePayment[]
  paddleWebhookEvents PaddleWebhookEvent[]
}

model User {
  id              String @id @default(cuid()) @db.VarChar(36)
  email           String             @unique @db.VarChar(191)
  passwordHash    String             @db.VarChar(255)
  fullName        String             @db.VarChar(191)
  emailVerifiedAt DateTime?
  isPlatformAdmin Boolean            @default(false)
  disabledAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  memberships       Membership[]
  sessions          Session[]
  auditEvents       AuditLog[]          @relation("AuditActor")
  assetEvents       AssetTransaction[]  @relation("TransactionActor")
  submittedRequests AssetRequest[]      @relation("RequestSubmitter")
  decidedRequests   AssetRequest[]      @relation("RequestDecider")
  createdTransfers  AssetTransfer[]     @relation("TransferCreator")
  resolvedTransferLines AssetTransferLine[] @relation("TransferLineResolver")
  platformAuditEvents   PlatformAuditLog[]   @relation("PlatformAuditActor")
}

model Session {
  id             String @id @default(cuid()) @db.VarChar(36)
  userId         String @db.VarChar(36)
  tokenHash      String    @unique @db.Char(64)
  csrfToken      String    @db.Char(43)
  expiresAt      DateTime
  lastSeenAt     DateTime?
  ipAddress      String?   @db.VarChar(64)
  userAgent      String?   @db.VarChar(500)
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Membership {
  id        String @id @default(cuid()) @db.VarChar(36)
  tenantId  String @db.VarChar(36)
  userId    String @db.VarChar(36)
  roleId    String @db.VarChar(36)
  isActive            Boolean               @default(true)
  allLocationsAccess  Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                Role                  @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  locationAssignments MembershipLocation[]  @relation("MembershipLocationAccess")

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, isActive])
  @@index([tenantId, roleId, isActive])
}

model MembershipLocation {
  id           String @id @default(cuid()) @db.VarChar(36)
  tenantId     String @db.VarChar(36)
  membershipId String @db.VarChar(36)
  locationId   String @db.VarChar(36)
  canManage    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership   Membership @relation("MembershipLocationAccess", fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  location     Location   @relation("LocationMembershipAccess", fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, membershipId, locationId])
  @@index([tenantId, locationId])
}

model Role {
  id          String @id @default(cuid()) @db.VarChar(36)
  tenantId    String @db.VarChar(36)
  key         String           @db.VarChar(100)
  name        String           @db.VarChar(191)
  description String?          @db.Text
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@index([tenantId, name])
}

model Permission {
  id          String @id @default(cuid()) @db.VarChar(36)
  key         String           @unique @db.VarChar(120)
  description String?          @db.Text
  assignments RolePermission[]
}

model RolePermission {
  roleId       String @db.VarChar(36)
  permissionId String @db.VarChar(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Location {
  id        String @id @default(cuid()) @db.VarChar(36)
  tenantId  String @db.VarChar(36)
  parentId  String? @db.VarChar(36)
  name      String     @db.VarChar(191)
  code      String     @db.VarChar(100)
  type      String     @default("BRANCH") @db.VarChar(60)
  address   String?    @db.VarChar(500)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Location[] @relation("LocationTree")
  assets    Asset[]    @relation("CurrentAssetLocation")
  employees Employee[]   @relation("EmployeeHomeLocation")
  sentTransactions AssetTransaction[] @relation("TransactionFromLocation")
  receivedTransactions AssetTransaction[] @relation("TransactionToLocation")
  outgoingTransfers    AssetTransfer[]    @relation("TransferOrigin")
  incomingTransfers    AssetTransfer[]    @relation("TransferDestination")
  membershipAssignments MembershipLocation[] @relation("LocationMembershipAccess")

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, parentId])
  @@index([tenantId, isActive])
}

model Employee {
  id             String @id @default(cuid()) @db.VarChar(36)
  tenantId       String @db.VarChar(36)
  employeeCode   String   @db.VarChar(100)
  firstName      String   @db.VarChar(100)
  lastName       String   @db.VarChar(100)
  email          String?  @db.VarChar(191)
  phone          String?  @db.VarChar(50)
  homeLocationId String? @db.VarChar(36)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedAssets Asset[]  @relation("AssetCustodian")
  homeLocation   Location? @relation("EmployeeHomeLocation", fields: [homeLocationId], references: [id], onDelete: Restrict)
  sentTransactions AssetTransaction[] @relation("TransactionFromEmployee")
  receivedTransactions AssetTransaction[] @relation("TransactionToEmployee")
  licenseAssignments LicenseAssignment[] @relation("LicenseAssignee")

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, id])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, homeLocationId])
}

model AssetCategory {
  id          String @id @default(cuid()) @db.VarChar(36)
  tenantId    String @db.VarChar(36)
  name        String      @db.VarChar(191)
  code        String      @db.VarChar(100)
  description String?     @db.Text
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models      AssetModel[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
}

model AssetModel {
  id          String @id @default(cuid()) @db.VarChar(36)
  tenantId    String @db.VarChar(36)
  categoryId  String @db.VarChar(36)
  name        String        @db.VarChar(191)
  code        String?       @db.VarChar(100)
  fieldSchema Json?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    AssetCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  assets      Asset[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, categoryId, isActive])
}

model Supplier {
  id        String @id @default(cuid()) @db.VarChar(36)
  tenantId  String @db.VarChar(36)
  name      String   @db.VarChar(191)
  email     String?  @db.VarChar(191)
  phone     String?  @db.VarChar(60)
  address   String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets    Asset[]
  softwareLicenses SoftwareLicense[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
}

model Manufacturer {
  id        String @id @default(cuid()) @db.VarChar(36)
  tenantId  String @db.VarChar(36)
  name      String   @db.VarChar(191)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets    Asset[]
  softwareLicenses SoftwareLicense[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
}

model Asset {
  id                  String @id @default(cuid()) @db.VarChar(36)
  tenantId            String @db.VarChar(36)
  inventoryNumber     String          @db.VarChar(191)
  assetNumber         String?         @db.VarChar(191)
  serialNumber        String?         @db.VarChar(191)
  title               String          @db.VarChar(191)
  description         String?         @db.Text
  modelId             String? @db.VarChar(36)
  manufacturerId      String? @db.VarChar(36)
  supplierId          String? @db.VarChar(36)
  currentLocationId   String? @db.VarChar(36)
  assignedEmployeeId  String? @db.VarChar(36)
  purchaseOrderNumber String?         @db.VarChar(191)
  accountCode         String?         @db.VarChar(100)
  purchasedAt         DateTime?
  purchaseCost        Decimal?        @db.Decimal(12, 2)
  salvageValue        Decimal?        @db.Decimal(12, 2)
  warrantyStart       DateTime?
  warrantyEnd         DateTime?
  expectedLifeMonths  Int?
  depreciationMethod  String?         @db.VarChar(60)
  status              AssetStatus     @default(AVAILABLE)
  customFields        Json?
  notes               String?         @db.Text
  disposedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model               AssetModel?     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  manufacturer        Manufacturer?    @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  supplier            Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  currentLocation     Location?       @relation("CurrentAssetLocation", fields: [currentLocationId], references: [id], onDelete: Restrict)
  custodian            Employee?      @relation("AssetCustodian", fields: [assignedEmployeeId], references: [id], onDelete: Restrict)
  transactions        AssetTransaction[]
  transferLines       AssetTransferLine[]
  serviceRecords      ServiceRecord[]
  tags                AssetTag[]
  files               TenantStorageObject[]

  @@unique([tenantId, inventoryNumber])
  @@unique([tenantId, id])
  @@index([tenantId, status, currentLocationId])
  @@index([tenantId, assignedEmployeeId])
  @@index([tenantId, serialNumber])
  @@index([tenantId, modelId])
}

model AssetTransaction {
  id             String @id @default(cuid()) @db.VarChar(36)
  tenantId       String @db.VarChar(36)
  assetId        String @db.VarChar(36)
  eventType      AssetEventType
  fromLocationId String? @db.VarChar(36)
  toLocationId   String? @db.VarChar(36)
  fromEmployeeId String? @db.VarChar(36)
  toEmployeeId   String? @db.VarChar(36)
  actorUserId    String? @db.VarChar(36)
  notes          String?         @db.Text
  occurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset          Asset           @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Restrict)
  actor          User?           @relation("TransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  fromLocation    Location?       @relation("TransactionFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation      Location?       @relation("TransactionToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  fromEmployee    Employee?       @relation("TransactionFromEmployee", fields: [fromEmployeeId], references: [id], onDelete: Restrict)
  toEmployee      Employee?       @relation("TransactionToEmployee", fields: [toEmployeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, assetId, occurredAt])
  @@index([tenantId, eventType, occurredAt])
}

model AssetRequest {
  id             String @id @default(cuid()) @db.VarChar(36)
  tenantId       String @db.VarChar(36)
  requestedById  String @db.VarChar(36)
  requestType    AssetRequestType
  status         RequestStatus    @default(PENDING)
  businessReason String?          @db.Text
  decidedById    String? @db.VarChar(36)
  decidedAt      DateTime?
  decisionReason String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy    User              @relation("RequestSubmitter", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy      User?             @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  items          AssetRequestItem[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, requestedById, createdAt])
}

model AssetTransfer {
  id                  String @id @default(cuid()) @db.VarChar(36)
  tenantId            String @db.VarChar(36)
  transferNumber      String        @db.VarChar(64)
  originLocationId    String @db.VarChar(36)
  destinationLocationId String @db.VarChar(36)
  status              TransferStatus @default(IN_TRANSIT)
  notes               String?       @db.Text
  createdByUserId     String @db.VarChar(36)
  dispatchedAt        DateTime      @default(now())
  completedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originLocation      Location      @relation("TransferOrigin", fields: [tenantId, originLocationId], references: [tenantId, id], onDelete: Restrict)
  destinationLocation Location      @relation("TransferDestination", fields: [tenantId, destinationLocationId], references: [tenantId, id], onDelete: Restrict)
  createdBy           User          @relation("TransferCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines               AssetTransferLine[]

  @@unique([tenantId, transferNumber])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, originLocationId, status])
  @@index([tenantId, destinationLocationId, status])
}

model AssetTransferLine {
  id               String @id @default(cuid()) @db.VarChar(36)
  tenantId         String @db.VarChar(36)
  transferId       String @db.VarChar(36)
  assetId          String @db.VarChar(36)
  status           TransferLineStatus @default(IN_TRANSIT)
  decisionReason   String?           @db.Text
  resolvedByUserId String? @db.VarChar(36)
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transfer         AssetTransfer     @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Cascade)
  asset            Asset             @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Restrict)
  resolvedBy       User?             @relation("TransferLineResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, transferId, assetId])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, transferId, status])
  @@index([tenantId, assetId, status])
}

model ServiceRecord {
  id            String @id @default(cuid()) @db.VarChar(36)
  tenantId      String @db.VarChar(36)
  assetId       String @db.VarChar(36)
  serviceNumber String        @db.VarChar(100)
  serviceType   String?       @db.VarChar(100)
  status        ServiceStatus @default(OPEN)
  provider      String?       @db.VarChar(191)
  cost          Decimal?      @db.Decimal(12, 2)
  serviceInAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  outcome       String?       @db.Text
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset         Asset         @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, serviceNumber])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, assetId, createdAt])
}

model SoftwareLicense {
  id             String @id @default(cuid()) @db.VarChar(36)
  tenantId       String @db.VarChar(36)
  name           String              @db.VarChar(191)
  category       String?             @db.VarChar(100)
  description    String?             @db.Text
  licenseStart   DateTime?
  licenseEnd     DateTime?
  seatCount      Int                 @default(1)
  supplierId     String? @db.VarChar(36)
  manufacturerId String? @db.VarChar(36)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier       Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  manufacturer   Manufacturer?       @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  assignments    LicenseAssignment[]
  requestItems   AssetRequestItem[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, licenseEnd, isActive])
}

model AssetRequestItem {
  id               String @id @default(cuid()) @db.VarChar(36)
  tenantId         String @db.VarChar(36)
  requestId        String @db.VarChar(36)
  itemType         AssetRequestType
  description      String           @db.VarChar(500)
  quantity         Int              @default(1)
  approvedQuantity Int?
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request          AssetRequest     @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade)
  softwareLicenseId String? @db.VarChar(36)
  softwareLicense  SoftwareLicense? @relation(fields: [softwareLicenseId], references: [id], onDelete: Restrict)

  @@index([tenantId, requestId])
}

model LicenseAssignment {
  id                   String @id @default(cuid()) @db.VarChar(36)
  tenantId             String @db.VarChar(36)
  softwareLicenseId    String @db.VarChar(36)
  assignedToEmployeeId String? @db.VarChar(36)
  deviceIdentifier     String?         @db.VarChar(191)
  referenceNumber      String?         @db.VarChar(191)
  notes                String?         @db.Text
  assignedAt           DateTime        @default(now())
  unassignedAt         DateTime?
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  softwareLicense      SoftwareLicense @relation(fields: [tenantId, softwareLicenseId], references: [tenantId, id], onDelete: Cascade)
  employee             Employee?       @relation("LicenseAssignee", fields: [assignedToEmployeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, softwareLicenseId, unassignedAt])
  @@index([tenantId, assignedToEmployeeId, unassignedAt])
}

model AssetTag {
  id        String @id @default(cuid()) @db.VarChar(36)
  tenantId  String @db.VarChar(36)
  assetId   String @db.VarChar(36)
  code      String   @db.VarChar(191)
  tagType   String   @default("QR") @db.VarChar(30)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, assetId])
}

model AuditLog {
  id          String @id @default(cuid()) @db.VarChar(36)
  tenantId    String @db.VarChar(36)
  actorUserId String? @db.VarChar(36)
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String? @db.VarChar(100)
  oldData     Json?
  newData     Json?
  ipAddress   String?  @db.VarChar(64)
  requestId         String? @db.VarChar(191)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId, createdAt])
}

model SubscriptionPlan {
  id                String @id @default(cuid()) @db.VarChar(36)
  key               String               @unique @db.VarChar(60)
  name              String               @db.VarChar(100)
  description       String?              @db.Text
  maxAssets         Int?
  maxActiveUsers    Int?
  storageLimitBytes BigInt?
  trialDurationDays Int                  @default(14)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  subscriptions     TenantSubscription[]
  paddleCheckoutAttempts PaddleCheckoutAttempt[]
  paddleProductId String? @db.VarChar(80)
  paddleSandboxMonthlyPriceId String? @db.VarChar(80)
  paddleSandboxYearlyPriceId  String? @db.VarChar(80)
  paddleLiveMonthlyPriceId    String? @db.VarChar(80)
  paddleLiveYearlyPriceId     String? @db.VarChar(80)

  @@index([isActive, name])
}

model TenantSubscription {
  id                    String @id @default(cuid()) @db.VarChar(36)
  tenantId              String @unique @db.VarChar(36)
  planId                String @db.VarChar(36)
  status                SubscriptionStatus @default(TRIALING)
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  currentPeriodStartsAt DateTime?
  currentPeriodEndsAt   DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  billingSource        String             @default("PLATFORM") @db.VarChar(20)
  paddleSubscriptionId String?            @unique @db.VarChar(80)
  paddleCustomerId     String?            @db.VarChar(80)
  paddlePriceId        String?            @db.VarChar(80)
  paddleEnvironment    String?            @db.VarChar(16)
  paddleInterval       String?            @db.VarChar(10)
  paddleLastEventAt    DateTime?
  paddlePendingPriceId String?            @db.VarChar(80)
  cancelledAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, status])
  @@index([status, trialEndsAt])
}

model PlatformAuditLog {
  id          String @id @default(cuid()) @db.VarChar(36)
  actorUserId String? @db.VarChar(36)
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String? @db.VarChar(100)
  reason      String   @db.Text
  oldData     Json?
  newData     Json?
  ipAddress   String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  actor       User?    @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model TenantStorageObject {
  id          String   @id @default(cuid()) @db.VarChar(36)
  tenantId    String   @db.VarChar(36)
  assetId     String   @db.VarChar(36)
  filename    String   @db.VarChar(191)
  mimeType    String   @db.VarChar(100)
  sizeBytes   Int
  content     Bytes    @db.LongBlob
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset    @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, assetId, createdAt])
}

model PaddleBillingCustomer {
  id               String   @id @default(cuid()) @db.VarChar(36)
  tenantId         String   @unique @db.VarChar(36)
  email            String   @db.VarChar(191)
  name             String   @db.VarChar(191)
  paddleCustomerId String?  @unique @db.VarChar(80)
  environment      String   @db.VarChar(16)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attempts         PaddleCheckoutAttempt[]

  @@index([environment, email])
}

model PaddleCheckoutAttempt {
  id             String   @id @default(cuid()) @db.VarChar(36)
  tenantId       String   @db.VarChar(36)
  planId         String   @db.VarChar(36)
  customerId     String   @db.VarChar(36)
  environment    String   @db.VarChar(16)
  interval       String   @db.VarChar(10)
  priceId        String   @db.VarChar(80)
  transactionId  String?  @unique @db.VarChar(80)
  checkoutUrl    String?  @db.VarChar(1500)
  status         String   @default("PENDING") @db.VarChar(30)
  lastError      String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  customer       PaddleBillingCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, environment, status, createdAt])
  @@index([tenantId, transactionId])
}

model PaddlePayment {
  id             String @id @default(cuid()) @db.VarChar(36)
  tenantId       String @db.VarChar(36)
  transactionId  String @unique @db.VarChar(80)
  subscriptionId String? @db.VarChar(80)
  status         String @db.VarChar(30)
  amountMinor    Int
  currency       String @db.VarChar(3)
  invoiceNumber  String? @db.VarChar(80)
  occurredAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([tenantId, status])
}

model PaddleWebhookEvent {
  id          String @id @default(cuid()) @db.VarChar(36)
  eventId     String @unique @db.VarChar(100)
  tenantId    String? @db.VarChar(36)
  environment String @db.VarChar(16)
  eventType   String @db.VarChar(100)
  occurredAt  DateTime
  status      String @default("RECEIVED") @db.VarChar(25)
  lastError   String? @db.VarChar(500)
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([tenantId, receivedAt])
}
