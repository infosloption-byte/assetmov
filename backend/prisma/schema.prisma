generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum AssetStatus {
  DRAFT
  AVAILABLE
  ASSIGNED
  IN_TRANSIT
  IN_SERVICE
  DAMAGED
  DISPOSED
  RETIRED
}

enum AssetEventType {
  REGISTERED
  ASSIGNED
  UNASSIGNED
  TRANSFER_DISPATCHED
  TRANSFER_RECEIVED
  TRANSFER_REJECTED
  CHECKED_IN
  CHECKED_OUT
  MARKED_DAMAGED
  MARKED_AVAILABLE
  DISPOSED
  RETIRED
  SERVICE_STARTED
  SERVICE_COMPLETED
  UPGRADED
  CORRECTED
}

enum AssetRequestType {
  ASSET
  SOFTWARE
  SERVICE
}

enum RequestStatus {
  PENDING
  CHANGES_REQUESTED
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  CANCELLED
  FULFILLMENT_IN_PROGRESS
  FULFILLED
}

enum ServiceStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_VENDOR
  COMPLETED
  CANCELLED
}

model Tenant {
  id                String               @id @default(cuid())
  name              String               @db.VarChar(191)
  slug              String               @unique @db.VarChar(100)
  status            TenantStatus         @default(TRIAL)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  memberships       Membership[]
  roles             Role[]
  requestItems      AssetRequestItem[]
  locations         Location[]
  employees         Employee[]
  categories        AssetCategory[]
  assetModels       AssetModel[]
  suppliers         Supplier[]
  manufacturers     Manufacturer[]
  assets            Asset[]
  assetTransactions AssetTransaction[]
  auditLogs         AuditLog[]
  requests          AssetRequest[]
  serviceRecords    ServiceRecord[]
  softwareLicenses  SoftwareLicense[]
  assetTags         AssetTag[]
  licenseAssignments LicenseAssignment[]
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique @db.VarChar(191)
  passwordHash    String             @db.VarChar(255)
  fullName        String             @db.VarChar(191)
  emailVerifiedAt DateTime?
  isPlatformAdmin Boolean            @default(false)
  disabledAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  memberships       Membership[]
  auditEvents       AuditLog[]          @relation("AuditActor")
  assetEvents       AssetTransaction[]  @relation("TransactionActor")
  submittedRequests AssetRequest[]      @relation("RequestSubmitter")
  decidedRequests   AssetRequest[]      @relation("RequestDecider")
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId, isActive])
  @@index([tenantId, roleId, isActive])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  key         String           @db.VarChar(100)
  name        String           @db.VarChar(191)
  description String?          @db.Text
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(120)
  description String?          @db.Text
  assignments RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Location {
  id        String     @id @default(cuid())
  tenantId  String
  parentId  String?
  name      String     @db.VarChar(191)
  code      String     @db.VarChar(100)
  type      String     @default("BRANCH") @db.VarChar(60)
  address   String?    @db.VarChar(500)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Location[] @relation("LocationTree")
  assets    Asset[]    @relation("CurrentAssetLocation")
  employees Employee[]   @relation("EmployeeHomeLocation")
  sentTransactions AssetTransaction[] @relation("TransactionFromLocation")
  receivedTransactions AssetTransaction[] @relation("TransactionToLocation")

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, isActive])
}

model Employee {
  id             String   @id @default(cuid())
  tenantId       String
  employeeCode   String   @db.VarChar(100)
  firstName      String   @db.VarChar(100)
  lastName       String   @db.VarChar(100)
  email          String?  @db.VarChar(191)
  phone          String?  @db.VarChar(50)
  homeLocationId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedAssets Asset[]  @relation("AssetCustodian")
  homeLocation   Location? @relation("EmployeeHomeLocation", fields: [homeLocationId], references: [id], onDelete: SetNull)
  sentTransactions AssetTransaction[] @relation("TransactionFromEmployee")
  receivedTransactions AssetTransaction[] @relation("TransactionToEmployee")

  @@unique([tenantId, employeeCode])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, homeLocationId])
}

model AssetCategory {
  id          String      @id @default(cuid())
  tenantId    String
  name        String      @db.VarChar(191)
  code        String      @db.VarChar(100)
  description String?     @db.Text
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models      AssetModel[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model AssetModel {
  id          String        @id @default(cuid())
  tenantId    String
  categoryId  String
  name        String        @db.VarChar(191)
  code        String?       @db.VarChar(100)
  fieldSchema Json?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assets      Asset[]

  @@unique([tenantId, name])
  @@index([tenantId, categoryId, isActive])
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String   @db.VarChar(191)
  email     String?  @db.VarChar(191)
  phone     String?  @db.VarChar(60)
  address   String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets    Asset[]
  softwareLicenses SoftwareLicense[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model Manufacturer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String   @db.VarChar(191)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets    Asset[]
  softwareLicenses SoftwareLicense[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model Asset {
  id                  String          @id @default(cuid())
  tenantId            String
  inventoryNumber     String          @db.VarChar(191)
  assetNumber         String?         @db.VarChar(191)
  serialNumber        String?         @db.VarChar(191)
  title               String          @db.VarChar(191)
  description         String?         @db.Text
  modelId             String?
  manufacturerId      String?
  supplierId          String?
  currentLocationId   String?
  assignedEmployeeId  String?
  purchaseOrderNumber String?         @db.VarChar(191)
  accountCode         String?         @db.VarChar(100)
  purchasedAt         DateTime?
  purchaseCost        Decimal?        @db.Decimal(12, 2)
  salvageValue        Decimal?        @db.Decimal(12, 2)
  warrantyStart       DateTime?
  warrantyEnd         DateTime?
  expectedLifeMonths  Int?
  depreciationMethod  String?         @db.VarChar(60)
  status              AssetStatus     @default(AVAILABLE)
  customFields        Json?
  notes               String?         @db.Text
  disposedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model               AssetModel?     @relation(fields: [modelId], references: [id], onDelete: SetNull)
  manufacturer        Manufacturer?    @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  supplier            Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  currentLocation     Location?       @relation("CurrentAssetLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  custodian            Employee?      @relation("AssetCustodian", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  transactions        AssetTransaction[]
  serviceRecords      ServiceRecord[]
  tags                AssetTag[]

  @@unique([tenantId, inventoryNumber])
  @@index([tenantId, status, currentLocationId])
  @@index([tenantId, assignedEmployeeId])
  @@index([tenantId, serialNumber])
  @@index([tenantId, modelId])
}

model AssetTransaction {
  id             String          @id @default(cuid())
  tenantId       String
  assetId        String
  eventType      AssetEventType
  fromLocationId String?
  toLocationId   String?
  fromEmployeeId String?
  toEmployeeId   String?
  actorUserId    String?
  notes          String?         @db.Text
  occurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset          Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  actor          User?           @relation("TransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  fromLocation    Location?       @relation("TransactionFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation      Location?       @relation("TransactionToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  fromEmployee    Employee?       @relation("TransactionFromEmployee", fields: [fromEmployeeId], references: [id], onDelete: SetNull)
  toEmployee      Employee?       @relation("TransactionToEmployee", fields: [toEmployeeId], references: [id], onDelete: SetNull)

  @@index([tenantId, assetId, occurredAt])
  @@index([tenantId, eventType, occurredAt])
}

model AssetRequest {
  id             String           @id @default(cuid())
  tenantId       String
  requestedById  String
  requestType    AssetRequestType
  status         RequestStatus    @default(PENDING)
  businessReason String?          @db.Text
  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy    User              @relation("RequestSubmitter", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy      User?             @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  items          AssetRequestItem[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, requestedById, createdAt])
}

model ServiceRecord {
  id            String        @id @default(cuid())
  tenantId      String
  assetId       String
  serviceNumber String        @db.VarChar(100)
  serviceType   String?       @db.VarChar(100)
  status        ServiceStatus @default(OPEN)
  provider      String?       @db.VarChar(191)
  cost          Decimal?      @db.Decimal(12, 2)
  serviceInAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  outcome       String?       @db.Text
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset         Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([tenantId, serviceNumber])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, assetId, createdAt])
}

model SoftwareLicense {
  id             String              @id @default(cuid())
  tenantId       String
  name           String              @db.VarChar(191)
  category       String?             @db.VarChar(100)
  description    String?             @db.Text
  licenseStart   DateTime?
  licenseEnd     DateTime?
  seatCount      Int                 @default(1)
  supplierId     String?
  manufacturerId String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier       Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  manufacturer   Manufacturer?       @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  assignments    LicenseAssignment[]
  requestItems   AssetRequestItem[]

  @@unique([tenantId, name])
  @@index([tenantId, licenseEnd, isActive])
}

model AssetRequestItem {
  id               String           @id @default(cuid())
  tenantId         String
  requestId        String
  itemType         AssetRequestType
  description      String           @db.VarChar(500)
  quantity         Int              @default(1)
  approvedQuantity Int?
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request          AssetRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  softwareLicenseId String?
  softwareLicense  SoftwareLicense? @relation(fields: [softwareLicenseId], references: [id], onDelete: SetNull)

  @@index([tenantId, requestId])
}

model LicenseAssignment {
  id                   String          @id @default(cuid())
  tenantId             String
  softwareLicenseId    String
  assignedToEmployeeId String?
  deviceIdentifier     String?         @db.VarChar(191)
  referenceNumber      String?         @db.VarChar(191)
  notes                String?         @db.Text
  assignedAt           DateTime        @default(now())
  unassignedAt         DateTime?
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  softwareLicense      SoftwareLicense @relation(fields: [softwareLicenseId], references: [id], onDelete: Cascade)

  @@index([tenantId, softwareLicenseId, unassignedAt])
  @@index([tenantId, assignedToEmployeeId, unassignedAt])
}

model AssetTag {
  id        String   @id @default(cuid())
  tenantId  String
  assetId   String
  code      String   @db.VarChar(191)
  tagType   String   @default("QR") @db.VarChar(30)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, assetId])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(191)
  oldData     Json?
  newData     Json?
  ipAddress   String?  @db.VarChar(64)
  requestId   String?  @db.VarChar(191)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId, createdAt])
}
